{
  "name": "amblique-qa-marketstreet",
  "version": "1.0.0",
  "description": "Playwright test suite for Market Street storefront – Home and Category Listing, desktop and mobile",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:desktop": "playwright test --project=desktop",
    "test:mobile": "playwright test --project=mobile",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^26.2.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "typescript": "^5.5.0"
  }
}
